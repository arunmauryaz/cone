# Environment reference. The backend does not automatically load this file.
# In PowerShell: $env:CONE_BIND = '127.0.0.1:8000'
CONE_BIND=127.0.0.1:8000
CONE_DATABASE_PATH=data/cone.sqlite3
CONE_MARKET_PROVIDER=upstox
# Optional local-development account: admin / admin123. Loopback binding only.
# CONE_LOCAL_ADMIN=true
CONE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Optional: serve a built React interface from the Rust process.
# CONE_WEB_DIR=frontend/dist
# Local users can configure this in Settings > Market Data instead.
# Saved data/market-provider.json overrides these initial provider defaults.
# Upstox mode downloads its official instrument master and needs a token for quotes:
# CONE_MARKET_PROVIDER=upstox
# CONE_INSTRUMENTS_FILE=data/your-live-instruments.json # optional custom catalogue
# CONE_UPSTOX_ACCESS_TOKEN=your-server-only-access-token
# First-user seed values come from data/local-setup.json or environment inputs.
# CONE_INITIAL_USERNAME=your-first-user
# CONE_INITIAL_PASSWORD=your-initial-password
